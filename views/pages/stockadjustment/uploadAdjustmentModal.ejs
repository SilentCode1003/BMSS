<div class="modal fade " id="uploadAdjustmentModal" tabindex="-1" role="dialog" aria-labelledby="uploadAdjustmentModalLabel"
  aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header custom-bg">
        <h5 class="modal-title" id="uploadAdjustmentModalLabel">Stock Adjustment</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="custom-modal-body">
        <div class="card ">
          <div class="card-header py-2 header-bg">
            <h6 class="m-0 font-weight-bold table-title">Bulk Stock Adjustment: </h6>
          </div>
          <div class="card-body">
            <div class="row mb-2 justify-content-center">
              <div class="col-md-6">
                <input class="btn btn-outline-cyberpower w-100" type="file" id="fileinput" accept=".xlsx, .xls"
                  placeholder="Select Excel File" />
              </div>

            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-inventory" id="closeBtn" data-dismiss="modal">Close</button>
        <button type="button" id="upload-adjustment-btn" class="btn btn-outline-inventory">
          <span class="spinner-border spinner-border-sm d-none" role="status" id="upload-spinner"></span>
          <span id="upload-text">Upload</span>
        </button>
      </div>
    </div>
  </div>
</div>